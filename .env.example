# Copy to .env.local and restart the dev server. The key is read only by /api/coach.
# Leave the key empty, or set PROVIDER=local, to score with the local rubric.
# Gemini calls the Developer API at generativelanguage.googleapis.com/v1beta.
# Create the key in Google AI Studio (aistudio.google.com/apikey). It starts with AIza.
# Set MODEL to a model ID from that project, not a placeholder such as YOUR_MODEL_ID.
# Leave application restrictions off so this server can call the API.
# Leave BASE_URL empty to use https://generativelanguage.googleapis.com/v1beta.
# This app does not enable billing. There is no paid fallback.

INTERVIEWVERSE_COACH_PROVIDER=gemini
INTERVIEWVERSE_COACH_API_KEY=
INTERVIEWVERSE_COACH_MODEL=
INTERVIEWVERSE_COACH_BASE_URL=
